# Manual deployment with deploy/xgift.service (installer writes its own site.env).
XGIFT_ORIGIN=https://gift.example.com
XGIFT_LISTEN=127.0.0.1:8787
XGIFT_DATA_DIR=/var/lib/xgift
# These owner-only files live inside the unit's writable data directory.
# Create vault/setup passwords before starting; do NOT precreate admin-password.
XGIFT_PASSWORD_FILE=/var/lib/xgift/secrets/vault-password
XGIFT_ADMIN_PASSWORD_FILE=/var/lib/xgift/secrets/admin-password
XGIFT_SETUP_PASSWORD_FILE=/var/lib/xgift/secrets/setup-password
# Enable only after configuring business credentials in /admin, then restart.
XGIFT_PAYMENTS_ENABLED=false

# Configure both values to enable server-verified Turnstile on public submissions.
# Keep the secret in a private file, never in source control.
XGIFT_TURNSTILE_SITE_KEY=
XGIFT_TURNSTILE_SECRET_FILE=
